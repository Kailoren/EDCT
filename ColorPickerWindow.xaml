<Window x:Class="ColonyTracker.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ColonyTracker"
        Title="Choose Color" Icon="Assets/ColonyTrackerIcon.ico" Width="360" SizeToContent="Height"
        Background="{StaticResource WindowBackground}" TextElement.Foreground="{StaticResource WindowForeground}"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="0"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <DockPanel>
        <local:DialogTitleBar DockPanel.Dock="Top" TitleText="Choose Color" CloseClicked="Cancel_Click"/>

        <StackPanel Margin="16">
            <Border x:Name="PreviewSwatch" Height="48" BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="4" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Hex" VerticalAlignment="Center"/>
                <TextBox x:Name="HexBox" Grid.Column="1" FontFamily="Consolas"
                         TextChanged="HexBox_TextChanged"/>
            </Grid>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="R" VerticalAlignment="Center" Foreground="{StaticResource Accent}"/>
                <Slider x:Name="RedSlider" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="ChannelSlider_ValueChanged"/>
                <TextBlock x:Name="RedLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="G" VerticalAlignment="Center" Foreground="{StaticResource Accent}"/>
                <Slider x:Name="GreenSlider" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="ChannelSlider_ValueChanged"/>
                <TextBlock x:Name="GreenLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="B" VerticalAlignment="Center" Foreground="{StaticResource Accent}"/>
                <Slider x:Name="BlueSlider" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="ChannelSlider_ValueChanged"/>
                <TextBlock x:Name="BlueLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Padding="14,5" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
                <Button Content="OK" Padding="14,5" Click="Ok_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
