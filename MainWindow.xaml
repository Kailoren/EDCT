<Window x:Class="ColonyTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ColonyTracker" Icon="Assets/ColonyTrackerIcon.ico"
        Height="760" Width="1280" MinHeight="480" MinWidth="900"
        Background="{StaticResource WindowBackground}" TextElement.Foreground="{StaticResource WindowForeground}"
        FontFamily="Segoe UI" FontSize="13"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewMouseDown="Window_PreviewMouseDown">

    <!-- Custom title bar (see the Border below): WindowChrome keeps the native resize border /
         Aero-snap / drop shadow, but hands the top CaptionHeight strip to our own content instead
         of drawing the system caption. Only the min/max/close buttons are marked
         IsHitTestVisibleInChrome; everything else in that strip is drag-to-move for free. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <DockPanel>
        <Border DockPanel.Dock="Top" Height="36" Background="{StaticResource WindowBackground}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="Assets/ColonyTrackerIcon.ico" Width="16" Height="16"/>
                    <TextBlock Text="ColonyTracker" Margin="8,0,0,0" FontSize="12"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}"
                            Click="MinimizeButton_Click" ToolTip="Minimize"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Width="10" Height="10" Stretch="None" Data="M0,5.5 H10"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1"/>
                    </Button>
                    <Button x:Name="MaximizeRestoreButton" Style="{StaticResource CaptionButton}"
                            Click="MaximizeRestoreButton_Click" ToolTip="Maximize"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid Width="10" Height="10">
                            <Path x:Name="MaximizeIcon" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1"/>
                            <Canvas x:Name="RestoreIcon" Visibility="Collapsed">
                                <Rectangle Canvas.Left="2.5" Canvas.Top="0" Width="7.5" Height="7.5"
                                           Fill="Transparent"
                                           Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                           StrokeThickness="1"/>
                                <Rectangle Canvas.Left="0" Canvas.Top="2.5" Width="7.5" Height="7.5"
                                           Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Background}"
                                           Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                           StrokeThickness="1"/>
                            </Canvas>
                        </Grid>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}"
                            Click="CloseButton_Click" ToolTip="Close"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Width="10" Height="10" Stretch="None" Data="M0,0 L10,10 M0,10 L10,0"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.2"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" Padding="16,8">
            <DockPanel>
                <Button Content="Rescan Journal" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right"
                        Padding="10,4" Margin="14,0,0,0" Command="{Binding RescanJournalCommand}"
                        ToolTip="Force a fresh re-read of the current game session's journal - use if live tracking (Ship/Delivered/Carrier Auto) looks out of sync, without restarting the app."/>
                <TextBlock Text="{Binding LastEventText}" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBlock Text="{Binding JournalStatus}" Foreground="{StaticResource Header}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="16,10,16,4">
            <TextBlock Text="Colonisation Cargo Tracker" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Content="Settings" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right"
                    Padding="12,5" Click="SettingsButton_Click"/>
            <Button x:Name="OverlayToggleButton" Content="Show Overlay" DockPanel.Dock="Right"
                    Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,14,0"
                    Click="OverlayToggleButton_Click"/>
            <CheckBox x:Name="OverlayLockCheckBox" Content="Lock overlay (click-through)" DockPanel.Dock="Right"
                      Visibility="Collapsed" Margin="0,0,14,0"
                      VerticalAlignment="Center" Click="OverlayLockCheckBox_Click"/>
        </DockPanel>

        <Grid Margin="16,4,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock Text="Colony Projects" FontWeight="SemiBold" Foreground="{StaticResource Header}"
                           DockPanel.Dock="Top" Margin="0,0,0,6"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="+ New" Click="AddProjectButton_Click" Padding="10,4" Margin="0,0,6,0"/>
                    <Button Content="Delete" Style="{StaticResource SecondaryButton}"
                            Command="{Binding DeleteProjectCommand}" Padding="10,4"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" DisplayMemberPath="SystemName"/>
            </DockPanel>

            <Grid Grid.Column="2" IsEnabled="{Binding HasSelectedProject}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="System name:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource Muted}"/>
                    <TextBox Width="240" FocusVisualStyle="{x:Null}"
                             Text="{Binding SelectedProject.SystemName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <TabControl Grid.Row="1">
                    <TabItem Header="System Plan">
                        <DockPanel Margin="0,6,0,0">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="+ Add Slot" Command="{Binding AddSlotCommand}" Padding="10,4"/>
                                <!-- Only shown right after a delete, since Delete-key removal (no confirmation
                                     prompt) has no other undo path - a slot's own Remove button was replaced
                                     with the Completed checkbox column, so this is now the only safety net. -->
                                <Button Content="Undo Remove" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="8,0,0,0"
                                        Command="{Binding UndoDeleteSlotCommand}"
                                        Visibility="{Binding CanUndoDeleteSlot, Converter={StaticResource BoolToVisibleConverter}}"/>
                            </StackPanel>
                            <DataGrid x:Name="SlotsGrid" ItemsSource="{Binding SlotRows}" AutoGenerateColumns="False" IsReadOnly="False"
                                      AllowDrop="True" DragOver="SlotsGrid_DragOver" Drop="SlotsGrid_Drop"
                                      PreviewMouseLeftButtonDown="DataGridCell_PreviewMouseLeftButtonDown"
                                      PreviewKeyDown="SlotsGrid_PreviewKeyDown">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                                <Setter Property="Panel.ZIndex" Value="100"/>
                                                <Setter Property="Background" Value="#33FF7500"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="3" BlurRadius="14" Opacity="0.65"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="28" CanUserResize="False" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Background="Transparent" Cursor="SizeAll" ToolTip="Drag to reorder"
                                                      PreviewMouseLeftButtonDown="SlotDragHandle_PreviewMouseLeftButtonDown"
                                                      MouseMove="SlotDragHandle_MouseMove">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Rectangle Width="14" Height="1.5" Fill="{StaticResource Muted}" Margin="0,1.5"/>
                                                        <Rectangle Width="14" Height="1.5" Fill="{StaticResource Muted}" Margin="0,1.5"/>
                                                        <Rectangle Width="14" Height="1.5" Fill="{StaticResource Muted}" Margin="0,1.5"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn x:Name="LayoutBodyColumn" Header="Body" Binding="{Binding Body}" Width="90" ElementStyle="{StaticResource CenterCellText}" EditingElementStyle="{StaticResource EditingCellTextBox}"/>
                                    <DataGridTextColumn x:Name="LayoutSlotNumberColumn" Header="Slot #" Binding="{Binding SlotNumber}" Width="60" ElementStyle="{StaticResource CenterCellText}" EditingElementStyle="{StaticResource EditingCellTextBox}"/>
                                    <DataGridTextColumn x:Name="LayoutNameColumn" Header="Name" Binding="{Binding Name}" Width="160" ElementStyle="{StaticResource CenterCellText}" EditingElementStyle="{StaticResource EditingCellTextBox}"/>
                                    <DataGridTemplateColumn x:Name="LayoutStructureTypeColumn" Header="Structure Type" Width="280">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <!-- Background="Transparent" (not left unset) so the whole cell is mouse
                                                     hit-testable, not just wherever the centered text's glyphs render - a
                                                     bare TextBlock only hit-tests its glyphs, so a double-click landing in
                                                     the padded empty space around short text can miss it entirely. The
                                                     explicit handler is a robust backup regardless, since
                                                     DataGridTemplateColumn's built-in double-click-to-edit is known to be
                                                     unreliable in WPF - F2 always worked here even when double-click didn't. -->
                                                <TextBlock Text="{Binding StructureType}" Padding="4,0" Background="Transparent"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                                           MouseLeftButtonDown="TemplateColumnCell_MouseLeftButtonDown"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.StructureTypeNames, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          SelectedItem="{Binding StructureType, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn x:Name="LayoutStationTypeColumn" Header="Station Type" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StationType}" Padding="4,0" Background="Transparent"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                                           MouseLeftButtonDown="TemplateColumnCell_MouseLeftButtonDown"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding StationTypeOptions}"
                                                          SelectedItem="{Binding StationType, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn x:Name="LayoutNotesColumn" Header="Notes" Binding="{Binding Notes}" Width="160" ElementStyle="{StaticResource CenterCellText}" EditingElementStyle="{StaticResource EditingCellTextBox}"/>
                                    <DataGridTemplateColumn x:Name="LayoutActiveColumn" Header="Active" Width="55">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Active, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn x:Name="LayoutCompletedColumn" Header="Completed" Width="75">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <!-- Manually toggleable, but also auto-checked once this slot's live
                                                     depot data shows nothing remaining - see MainViewModel.
                                                     RebuildUnloadingSites. -->
                                                <CheckBox IsChecked="{Binding Completed, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Cargo Hauling">
                        <DockPanel Margin="0,6,0,0">
                            <Border DockPanel.Dock="Top" Background="#241809" Padding="10" Margin="0,0,0,8">
                                <DockPanel>
                                <Button Content="Search Again" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right"
                                        Padding="10,4" Margin="14,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding SearchAgainCommand}" ToolTip="Manually re-check hub prices/stock"/>
                                <!-- Empty (and so zero width) unless the relay turned the last
                                     refresh away; the button's own left margin is the gap. -->
                                <TextBlock Text="{Binding HubPricesStatus}" DockPanel.Dock="Right"
                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="SystemNameCopyText" Text="{Binding SelectedProject.SystemName}"
                                               FontWeight="Bold" Foreground="{StaticResource Accent}" Background="Transparent"
                                               Cursor="Hand" ToolTip="Click to copy system name" Margin="0,0,8,0"
                                               MouseLeftButtonDown="SystemNameCopyText_MouseLeftButtonDown"
                                               MouseEnter="CopyableText_MouseEnter" MouseLeave="CopyableText_MouseLeave"/>
                                    <TextBlock Text="Copied!" Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                                Margin="0,0,20,0" Visibility="{Binding SystemNameCopied, Converter={StaticResource BoolToVisibleConverter}}"/>
                                    <TextBlock Text="Still needed total: " FontWeight="Bold"/>
                                    <TextBlock Text="{Binding TotalStillNeeded}" Margin="0,0,20,0" Foreground="{StaticResource Accent}"/>
                                    <TextBlock Text="Trips (Large ship): " Foreground="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding TripsLargeShip}" Margin="0,0,20,0"/>
                                    <TextBlock Text="Trips (Medium ship): " Foreground="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding TripsMediumShip}" Margin="0,0,20,0"/>
                                    <TextBlock Text="Trips (Carrier load): " Foreground="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding TripsCarrier}" Margin="0,0,20,0"/>
                                </StackPanel>
                                </DockPanel>
                            </Border>
                            <Grid>
                            <DataGrid x:Name="CommodityGrid" ItemsSource="{Binding CommodityRows}" AutoGenerateColumns="False"
                                      PreviewMouseLeftButtonDown="DataGridCell_PreviewMouseLeftButtonDown">
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="CargoCategoryColumn" Header="Category" Binding="{Binding Category}" Width="130" IsReadOnly="True" ElementStyle="{StaticResource CenterCellText}"/>
                                    <DataGridTextColumn x:Name="CargoCommodityColumn" Header="Commodity" Binding="{Binding Name}" Width="190" IsReadOnly="True" ElementStyle="{StaticResource CenterCellText}"/>
                                    <DataGridTextColumn x:Name="CargoRequiredColumn" Header="Required" Binding="{Binding Required}" Width="80" IsReadOnly="True" ElementStyle="{StaticResource CenterCellText}"/>
                                    <DataGridTextColumn x:Name="CargoCarrierColumn" Header="Carrier" Binding="{Binding Carrier, UpdateSourceTrigger=PropertyChanged}" Width="80" ElementStyle="{StaticResource CenterCellText}" EditingElementStyle="{StaticResource EditingCellTextBox}">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="ToolTip" Value="Includes ship-to-carrier transfers auto-detected this session (the Transfer screen at your own carrier, not the commodity market) on top of whatever you've typed in - editing this cell adjusts your manual amount, not the auto-detected part."/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn x:Name="CargoShipColumn" Header="Ship" Binding="{Binding Ship}" Width="80" IsReadOnly="True" ElementStyle="{StaticResource CenterCellText}"/>
                                    <DataGridTextColumn x:Name="CargoDeliveredColumn" Header="Delivered" Binding="{Binding Delivered}" Width="85" IsReadOnly="True" ElementStyle="{StaticResource DeliveredCellText}"/>
                                    <DataGridTextColumn x:Name="CargoStillNeededColumn" Header="Still Needed" Binding="{Binding StillNeeded}" Width="95" IsReadOnly="True" ElementStyle="{StaticResource StillNeededCellText}"/>
                                    <DataGridTemplateColumn x:Name="CargoBestSourceColumn" Header="Best Hub Source" Width="150" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Image Source="{Binding BestSourceIsOrbital, Converter={StaticResource OrbitalToIconConverter}}"
                                                           Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding BestSourceStation}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn x:Name="CargoHubSystemColumn" Header="Hub System" Width="170" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding BestSourceSystem}" Background="Transparent" Cursor="Hand"
                                                           ToolTip="Click to copy system name" Padding="4,0"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           MouseLeftButtonDown="HubSystemText_MouseLeftButtonDown"
                                                           MouseEnter="CopyableText_MouseEnter" MouseLeave="CopyableText_MouseLeave"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn x:Name="CargoHubStockColumn" Header="Hub Stock" Binding="{Binding BestSourceStock, StringFormat={}{0:N0}}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource CenterCellText}"/>
                                    <DataGridTextColumn x:Name="CargoHubPriceColumn" Header="Hub Price" Binding="{Binding BestSourcePrice, StringFormat={}{0:N0}cr}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource CenterCellText}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Loading overlay for the hub-price refresh - the rotating arc runs
                                 continuously (RepeatBehavior=Forever, started once on Loaded) and is
                                 just hidden/shown via Visibility, rather than being started/stopped
                                 per refresh, to sidestep any Style/DataTrigger Storyboard-targeting
                                 subtleties. -->
                            <Border Background="#CC0A0705"
                                    Visibility="{Binding IsRefreshingHubPrices, Converter={StaticResource BoolToVisibleConverter}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Width="32" Height="32" Data="M16,2 A14,14 0 1 1 2,16"
                                          Stroke="{StaticResource Accent}" StrokeThickness="3"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="HubSearchSpinnerRotate" CenterX="16" CenterY="16"/>
                                        </Path.RenderTransform>
                                        <Path.Triggers>
                                            <EventTrigger RoutedEvent="Path.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="HubSearchSpinnerRotate" Storyboard.TargetProperty="Angle"
                                                                         From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Path.Triggers>
                                    </Path>
                                    <TextBlock Text="Searching..." Foreground="{StaticResource Muted}"
                                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            </Grid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
