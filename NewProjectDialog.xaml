<Window x:Class="ColonyTracker.NewProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ColonyTracker"
        Title="New Colony Project" Icon="Assets/ColonyTrackerIcon.ico" Width="520" SizeToContent="Height"
        Background="{StaticResource WindowBackground}" TextElement.Foreground="{StaticResource WindowForeground}"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="0"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <DockPanel>
        <local:DialogTitleBar DockPanel.Dock="Top" TitleText="New Colony Project" CloseClicked="Cancel_Click"/>

        <StackPanel Margin="16">
            <TextBlock Text="System name" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,6"/>
            <TextBox x:Name="SystemNameBox" Margin="0,0,0,16"/>

            <TextBlock Text="Slots" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,8"/>
            <RadioButton x:Name="FromScratchRadio" Content="Create from scratch" GroupName="Mode"
                         IsChecked="True" Margin="0,0,0,8" Checked="ModeRadio_Checked"/>
            <RadioButton x:Name="FromSheetRadio" Content="Reference from sheet" GroupName="Mode"
                         Margin="0,0,0,8" Checked="ModeRadio_Checked"/>
            <RadioButton x:Name="FromRavenColonialRadio" Content="Import Raven Colonial JSON export" GroupName="Mode"
                         Margin="0,0,0,8" Checked="ModeRadio_Checked"/>

            <StackPanel x:Name="SheetPastePanel" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,4,0,8"
                           Text="First, click Share on the sheet and set General access to &quot;Anyone with the link&quot; (Viewer) - required, or this will fail to read it. Then, with the right tab open, copy the URL straight from your browser's address bar (not the Share dialog's own &quot;Copy link&quot; button, which may not point at that specific tab) and paste it below. Recognized columns are Body, Slot, Name, Facility Construction/Structure Type, Notes, Build Active/Active, and Layout Variant/Station Type."/>
                <TextBox x:Name="SheetLinkBox" FontFamily="Consolas" FontSize="12"/>
            </StackPanel>

            <StackPanel x:Name="RavenColonialPastePanel" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,4,0,8"
                           Text="Load a system backup exported from ravencolonial.com, or paste its JSON content below. System name and body labels come from the file automatically."/>
                <Button Content="Browse for file..." Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                        Padding="10,4" Margin="0,0,0,8" Click="BrowseRavenColonialFile_Click"/>
                <TextBox x:Name="RavenColonialPasteBox" Height="140" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Padding="14,5" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
                <Button x:Name="CreateButton" Content="Create" Padding="14,5" Click="Create_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
